{
  "manifest_version": 3,
  "name": "PixAI 태그 서랍",
  "version": "0.2.3",
  "description": "PixAI 프롬프트 태그를 한글로 찾고, 저장하고, 클릭 한 번으로 넣는 사이드 패널",
  "permissions": ["sidePanel", "storage", "clipboardWrite"],
  "background": { "service_worker": "background.js" },
  "action": { "default_title": "PixAI 태그 서랍 열기" },
  "side_panel": { "default_path": "sidepanel.html" },
  "content_scripts": [
    { "matches": ["https://pixai.art/*"], "js": ["prompt.js", "content.js"] }
  ]
}
